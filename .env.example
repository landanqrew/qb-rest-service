# qb-service configuration template.
#
# Copy to a gitignored env file and fill in real values:
#   cp .env.example .env
#   cp .env.example .env.production
#   cp .env.example .env.sandbox
#
# NEVER commit a real `.env*` file. Runtime secrets and deploy targets are
# environment-specific and intentionally derived from ignored env files or the
# process environment.
#
# QBSVC_* variables are read by the FastAPI service. The deploy scripts also
# read the non-QBSVC variables below when invoked with ENV_FILE=.env.production
# or ENV_FILE=.env.sandbox.

# --- Local service / Intuit OAuth -----------------------------------------
QBSVC_INTUIT_CLIENT_ID=your-intuit-client-id
QBSVC_INTUIT_CLIENT_SECRET=your-intuit-client-secret

# "sandbox" routes QBO calls to sandbox-quickbooks.api.intuit.com and must pair
# with the app's Development keys + a sandbox realm. "production" for the live realm.
QBSVC_INTUIT_ENVIRONMENT=sandbox

# Company (realm) ID from the OAuth callback's realmId param.
QBSVC_REALM_ID=your-realm-id

# Full URL Intuit redirects to after consent; must match the Intuit console
# registration byte-for-byte. Local dev uses the loopback forwarder port.
QBSVC_OAUTH_REDIRECT_URI=http://localhost:8080/admin/oauth/callback

# --- Token storage ---
# "file" persists tokens to ~/.config/qbsvc/tokens.json (dev only, plaintext).
# "secret_manager" requires QBSVC_GCP_PROJECT, QBSVC_SECRET_NAME_TOKENS, and ADC.
# `scripts/seed_sandbox.py --re-pull-prod` uses those two values (or the
# GCP_PROJECT / SECRET_TOKENS deploy aliases below) with the Production client
# credentials and realm ID above to refresh ~/qb-export/prod-<REALM_ID>/.
QBSVC_TOKEN_BACKEND=file
# QBSVC_GCP_PROJECT=your-gcp-project
# QBSVC_SECRET_NAME_TOKENS=your-token-secret-name

# --- Admin gate ---
# Comma-separated emails allowed to reach /admin/*. Empty disables the gate,
# which is the right default for local dev (no Cloud Run IAM edge, no JWT).
# On Cloud Run the service refuses to start if this is empty (see admin_gate.py).
QBSVC_ADMIN_ALLOWLIST=

# --- Deploy scripts --------------------------------------------------------
# Used by deploy/deploy.sh and deploy/qb-admin.deploy.sh when ENV_FILE points
# at this file. These names are deliberately placeholders; choose names that
# match your own GCP project and Secret Manager setup.
GCP_PROJECT=your-gcp-project-id
REGION=us-central1
INTUIT_ENV=sandbox
REALM_ID=your-realm-id

# Artifact Registry repo and Cloud Run service names. SERVICE is optional:
# leave it unset to let deploy/deploy.sh choose qb-service/qb-service-sandbox
# and deploy/qb-admin.deploy.sh choose qb-admin/qb-admin-sandbox based on
# INTUIT_ENV.
AR_REPO=qb-service
# SERVICE=
# RUNTIME_SA=qb-service-runtime@your-gcp-project-id.iam.gserviceaccount.com

# Secret Manager secret names. Required by the deploy scripts; create these in
# your project before deploying and grant the runtime service account accessor
# permissions as described in deploy/iam-setup.md.
SECRET_CLIENT_ID=your-qbo-client-id-secret
SECRET_CLIENT_SECRET=your-qbo-client-secret-secret
SECRET_TOKENS=your-qbo-token-secret

# qb-admin.deploy.sh only: browser return URL and launch-token secret. The same
# launch secret value must also be available to the consuming app that mints
# /admin/oauth/start launch tokens.
RETURN_URL=https://your-app.example.com/settings/integrations
SECRET_ADMIN_LAUNCH=your-qbo-admin-launch-secret
