# qb-service local configuration template.
#
# Copy to `.env` (which is gitignored) and fill in real values for LOCAL dev:
#   cp .env.example .env
#
# NEVER commit a real `.env`. Production never reads `.env` — on Cloud Run the
# Intuit client id/secret are injected from Secret Manager (mwl-qb-client-id /
# mwl-qb-client-secret) and the token blob lives in mwl-qb-tokens. See
# deploy/oauth-setup.md and deploy/iam-setup.md.
#
# All variables are prefixed QBSVC_ (see src/qbsvc/config.py).

# --- Intuit OAuth app credentials (use Development keys for sandbox) ---
QBSVC_INTUIT_CLIENT_ID=your-intuit-client-id
QBSVC_INTUIT_CLIENT_SECRET=your-intuit-client-secret

# "sandbox" routes QBO calls to sandbox-quickbooks.api.intuit.com and must pair
# with the app's Development keys + a sandbox realm. "production" for the live realm.
QBSVC_INTUIT_ENVIRONMENT=sandbox

# Company (realm) ID from the OAuth callback's realmId param.
QBSVC_REALM_ID=your-realm-id

# Full URL Intuit redirects to after consent; must match the Intuit console
# registration byte-for-byte. Local dev uses the loopback forwarder port.
QBSVC_OAUTH_REDIRECT_URI=http://localhost:8080/admin/oauth/callback

# --- Token storage ---
# "file" persists tokens to ~/.config/qbsvc/tokens.json (dev only, plaintext).
# "secret_manager" requires QBSVC_GCP_PROJECT + ADC (prod, and the §3a bootstrap).
QBSVC_TOKEN_BACKEND=file
# QBSVC_GCP_PROJECT=your-gcp-project
# QBSVC_SECRET_NAME_TOKENS=mwl-qb-tokens

# --- Admin gate ---
# Comma-separated emails allowed to reach /admin/*. Empty disables the gate,
# which is the right default for local dev (no Cloud Run IAM edge, no JWT).
# On Cloud Run the service refuses to start if this is empty (see admin_gate.py).
QBSVC_ADMIN_ALLOWLIST=
